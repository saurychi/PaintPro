            style={{
              scrollbarWidth: "thin",
              scrollbarColor: `#00c065 var(--job-progress-scrollbar-track)`,
            } as React.CSSProperties}>
            {!selectedProject ? (
              <NoProjectEmptyState
                mode={emptyProjectState}
                onGoToReports={() => router.push("/admin/report")}
