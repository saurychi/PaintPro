                  <span>${escapeHtml(formatCurrency(summary.quotationTotal))}</span>
                </div>
              </div>
            </div>

            <div class="section card">
              <div class="heading">Payment Terms</div>
              <div class="terms">
                1. This invoice is based on the completed project scope, materials, and labor records.<br />
                2. Any approved variations or additional work may be reflected in the final invoice amount.<br />
                3. Payment is requested according to the agreed project payment terms.<br />
                4. This invoice is issued for client payment processing and project closeout.
              </div>
            </div>

            <div class="signature">
              <div class="sig-box">
                <div class="sig-image-wrap">
                  ${
                    adminSignatureInfo.signatureDataUrl
                      ? `<img src="${adminSignatureInfo.signatureDataUrl}" alt="Prepared by signature" class="sig-image" />`
                      : ""
                  }
                </div>
                <div class="sig-line">Prepared By</div>
                ${
                  adminSignatureInfo.username
                    ? `<div class="sig-name">${escapeHtml(adminSignatureInfo.username)}</div>`
                    : ""
                }
              </div>

              <div class="sig-box">
                <div class="sig-image-wrap">
                  ${
                    clientInvoiceSignatureInfo.signatureDataUrl
                      ? `<img src="${clientInvoiceSignatureInfo.signatureDataUrl}" alt="Client signature" class="sig-image" />`
                      : ""
                  }
                </div>
                <div class="sig-line">Received By / Client Signature</div>
                ${
                  clientInvoiceSignatureInfo.signedName
                    ? `<div class="sig-name">${escapeHtml(clientInvoiceSignatureInfo.signedName)}</div>`
                    : ""
                }
              </div>
            </div>
          </div>
        </body>
      </html>
    `;

    return new Response(html, {
      status: 200,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "no-store",
      },
    });
  } catch (error: any) {
    return NextResponse.json(
      {
        error: "Unexpected server error.",
        details: error?.message ?? "Unknown error",
      },
      { status: 500 },
    );
  }
}
