/* ── Global dark-mode overrides ─────────────────────────────────────────── */
/* Override common Tailwind utility classes when dark mode is active.        */
/* Placed outside @layer so they outrank Tailwind's generated utilities.     */

html.dark {
  background-color: var(--app-bg);
  color: var(--app-text);
}

/* Backgrounds */
html.dark .bg-white { background-color: var(--app-surface); }
html.dark .bg-gray-50 { background-color: var(--app-surface-2); }
html.dark .bg-gray-100 { background-color: var(--app-surface-2); }
html.dark .bg-gray-200 { background-color: var(--app-border); }

/* Hover backgrounds */
html.dark .hover\:bg-gray-50:hover { background-color: var(--app-surface-2); }
html.dark .hover\:bg-gray-100:hover { background-color: var(--app-border); }
html.dark .hover\:bg-white:hover { background-color: var(--app-surface); }

/* Text colors */
html.dark .text-gray-950,
html.dark .text-gray-900 { color: var(--app-text); }
html.dark .text-gray-800,
html.dark .text-gray-700 { color: var(--app-text-2); }
html.dark .text-gray-600,
html.dark .text-gray-500 { color: var(--app-text-muted); }
html.dark .text-gray-400,
html.dark .text-gray-300 { color: var(--app-text-faint); }

/* Border colors */
html.dark .border-gray-100,
html.dark .border-gray-200 { border-color: var(--app-border); }
html.dark .border-gray-300 { border-color: var(--app-border-2); }
html.dark .divide-gray-100 > :not([hidden]) ~ :not([hidden]),
html.dark .divide-gray-200 > :not([hidden]) ~ :not([hidden]) { border-color: var(--app-border); }

/* Danger */
html.dark .text-red-600,
html.dark .text-red-700 { color: var(--app-danger); }
html.dark .bg-red-50 { background-color: var(--app-danger-light); }
html.dark .border-red-200 { border-color: var(--app-danger); }
html.dark .hover\:bg-red-50:hover { background-color: var(--app-danger-light); }

/* Success */
html.dark .text-emerald-700,
html.dark .text-emerald-600 { color: var(--app-success); }
html.dark .bg-emerald-50 { background-color: var(--app-brand-light); }
