        fetch("/api/auth/client-access", { method: "DELETE" }),
      ]);

      try {
        localStorage.removeItem("paintpro_client_access");
        sessionStorage.removeItem("paintpro_client_access");
      } catch {}

      document.cookie =
        "paintpro_client_access=; Max-Age=0; Path=/; SameSite=Strict";
