                                </div>
                                <p className="mt-0.5 text-[11px] text-gray-500 dark:text-gray-400">
                                  {project.projectCode ?? "â€”"} ·{" "}
                                  {project.dateLabel}
                                </p>
                              </div>
                              <span className="shrink-0 text-[11px] font-medium capitalize text-gray-700 dark:text-gray-300">
                                {project.status}
                              </span>
