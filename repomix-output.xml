          </div>

          {mode === "create" && dateMode === "range" ? (
            <div className="grid gap-1.5">
              <label className="text-xs font-semibold uppercase tracking-[0.08em] text-gray-500">
                Type
              </label>
              <select
                value={form.blockType}
                onChange={(event) =>
