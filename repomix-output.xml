      const hasMeaningfulContent = Boolean(
        draft.projectName ||
        draft.description ||
        draft.address ||
        draft.clientName ||
        draft.clientEmail ||
        (Array.isArray(draft.measurementRows) &&
          draft.measurementRows.length > 0) ||
