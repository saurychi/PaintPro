 async function actionDownloadFile(file: FileItem) {
   try {
     if (file.contentType === "text/html") {
       const response = await fetch(
         `/api/documents/export-pdf?documentId=${encodeURIComponent(file.id)}`
       )

       if (!response.ok) {
         const data = await response.json().catch(() => null)
         throw new Error(
           [data?.error, data?.details].filter(Boolean).join(": ") ||
             "Failed to export PDF."
         )
       }

       const blob = await response.blob()
       const url = window.URL.createObjectURL(blob)
       const anchor = document.createElement("a")
       const safeName = file.name.replace(/[^\w\- ]+/g, "").trim() || "document"

       anchor.href = url
       anchor.download = `${safeName}.pdf`

       document.body.appendChild(anchor)
       anchor.click()
       anchor.remove()

       window.URL.revokeObjectURL(url)

       pushToast("Exported formatted PDF.", "success")
       setOpenMenuKey(null)
       return
     }

     const safeName = file.name.replace(/[^\w\- ]+/g, "").trim() || "document"
     const content = file.content || "No content saved for this document."

     downloadTextFile(`${safeName}.txt`, content)
     pushToast("Exported saved content.", "success")
     setOpenMenuKey(null)
   } catch (error: any) {
     pushToast(error?.message ?? "Export failed.", "danger")
   }
 }


