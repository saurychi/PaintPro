         }),
       ])


       if (cancelled) return


       setFolders(f)
       setFilesAll(a)


       setArchivedFolderIds(
         Object.fromEntries(f.filter((folder) => folder.isArchived).map((folder) => [folder.id, true]))
       )


       setArchivedFileIds(
