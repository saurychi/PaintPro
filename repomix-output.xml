<file path="components/project-creation/CreateClientModal.tsx">
"use client";

import { X, Plus, Loader2 } from "lucide-react";
import { PhoneCountryPicker } from "@/components/PhoneCountryPicker";

const ACCENT = "#00c065";
const ACCENT_HOVER = "#00a054";
const BORDER = "border border-gray-200";

type CountryCallingCodeOption = {
  country: string;
  calling_code: string;
};

type CreateClientModalProps = {
  open: boolean;
  creatingClient: boolean;
  fullName: string;
  email: string;
  phone: string;
  phoneCountry: string;
  address: string;
  notes: string;
  phoneCountryOptions: CountryCallingCodeOption[];
  onClose: () => void;
  onSubmit: () => void;
  onFullNameChange: (value: string) => void;
  onEmailChange: (value: string) => void;
  onPhoneChange: (value: string) => void;
  onPhoneCountryChange: (value: string) => void;
  onAddressChange: (value: string) => void;
  onNotesChange: (value: string) => void;
