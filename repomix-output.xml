                              "rounded-lg border px-3 py-2.5",
                              day.source === "holiday"
                                ? "border-amber-200 bg-amber-50 dark:border-amber-500/40 dark:bg-amber-400/15"
                                : "border-red-200 bg-red-50/60 dark:border-red-500/40 dark:bg-red-500/15",
